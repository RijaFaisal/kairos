# Inside docker compose the hosts are "postgres" and "redis", e.g.
#   DATABASE_URL=postgresql+asyncpg://<user>:<password>@postgres:5432/<db>
#   REDIS_URL=redis://redis:6379/0
DATABASE_URL=
REDIS_URL=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
OWNER_PHONES=

# Local postgres container (docker compose only). Must match DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
